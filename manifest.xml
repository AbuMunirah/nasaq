      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open the Nasaq tab on the ribbon to match, swap and align selected shapes.">
          <bt:Override Locale="ar-SA" Value="افتح علامة التبويب نَسَق على الشريط لمطابقة الأشكال المحددة وتبديلها ومحاذاتها."/>
        </bt:String>
        <bt:String id="MatchSize.Tooltip" DefaultValue="Resize all selected shapes to the width and height of the last shape you selected.">
          <bt:Override Locale="ar-SA" Value="تغيير حجم جميع الأشكال المحددة لتطابق عرض وارتفاع آخر شكل قمت بتحديده."/>
        </bt:String>
        <bt:String id="MatchWidth.Tooltip" DefaultValue="Resize all selected shapes to the width of the last shape you selected.">
          <bt:Override Locale="ar-SA" Value="تغيير عرض جميع الأشكال المحددة ليطابق عرض آخر شكل قمت بتحديده."/>
        </bt:String>
        <bt:String id="MatchHeight.Tooltip" DefaultValue="Resize all selected shapes to the height of the last shape you selected.">
          <bt:Override Locale="ar-SA" Value="تغيير ارتفاع جميع الأشكال المحددة ليطابق ارتفاع آخر شكل قمت بتحديده."/>
        </bt:String>
        <bt:String id="AlignCenter.Tooltip" DefaultValue="Center the selected shapes horizontally on the center of the last shape you selected.">
          <bt:Override Locale="ar-SA" Value="توسيط الأشكال المحددة أفقيًا على مركز آخر شكل قمت بتحديده."/>
        </bt:String>
        <bt:String id="AlignMiddle.Tooltip" DefaultValue="Center the selected shapes vertically on the middle of the last shape you selected.">
          <bt:Override Locale="ar-SA" Value="توسيط الأشكال المحددة عموديًا على منتصف آخر شكل قمت بتحديده."/>
        </bt:String>
        <bt:String id="TextAlignMenu.Tooltip" DefaultValue="Align the paragraphs of the selected text, or of all text in the selected shapes.">
          <bt:Override Locale="ar-SA" Value="محاذاة فقرات النص المحدد، أو كل النص في الأشكال المحددة."/>
        </bt:String>
        <bt:String id="TextAlignLeft.Tooltip" DefaultValue="Align text to the left.">
          <bt:Override Locale="ar-SA" Value="محاذاة النص إلى اليسار."/>
        </bt:String>
        <bt:String id="TextAlignCenter.Tooltip" DefaultValue="Center text.">
          <bt:Override Locale="ar-SA" Value="توسيط النص."/>
        </bt:String>
        <bt:String id="TextAlignRight.Tooltip" DefaultValue="Align text to the right.">
          <bt:Override Locale="ar-SA" Value="محاذاة النص إلى اليمين."/>
        </bt:String>
        <bt:String id="TextAlignJustify.Tooltip" DefaultValue="Justify text so it lines up with both margins.">
          <bt:Override Locale="ar-SA" Value="ضبط النص ليصطف مع الهامشين."/>
        </bt:String>
        <bt:String id="Swap.Tooltip" DefaultValue="Swap the positions of exactly two selected shapes, center to center.">
          <bt:Override Locale="ar-SA" Value="تبديل موضعي شكلين محددين بالضبط، من المركز إلى المركز."/>
        </bt:String>
        <bt:String id="AlignLeft.Tooltip" DefaultValue="Align the left edges of the selected shapes to the left edge of the last shape you selected.">
          <bt:Override Locale="ar-SA" Value="محاذاة الحواف اليسرى للأشكال المحددة مع الحافة اليسرى لآخر شكل قمت بتحديده."/>
        </bt:String>
        <bt:String id="AlignRight.Tooltip" DefaultValue="Align the right edges of the selected shapes to the right edge of the last shape you selected.">
          <bt:Override Locale="ar-SA" Value="محاذاة الحواف اليمنى للأشكال المحددة مع الحافة اليمنى لآخر شكل قمت بتحديده."/>
        </bt:String>
        <bt:String id="AlignTop.Tooltip" DefaultValue="Align the top edges of the selected shapes to the top edge of the last shape you selected.">
          <bt:Override Locale="ar-SA" Value="محاذاة الحواف العلوية للأشكال المحددة مع الحافة العلوية لآخر شكل قمت بتحديده."/>
        </bt:String>
        <bt:String id="AlignBottom.Tooltip" DefaultValue="Align the bottom edges of the selected shapes to the bottom edge of the last shape you selected.">
          <bt:Override Locale="ar-SA" Value="محاذاة الحواف السفلية للأشكال المحددة مع الحافة السفلية لآخر شكل قمت بتحديده."/>
        </bt:String>
      </bt:LongStrings>
