Attribute VB_Name = "Nasaq"
' Nasaq - VBA edition of the Nasaq PowerPoint add-in, for PowerPoint versions
' without the PowerPoint JavaScript API 1.5 (e.g. Office LTSC 2021 and older).
'
' Ribbon: customUI14.xml calls Nasaq_GetLabel, Nasaq_GetSupertip and Nasaq_OnAction.
' Every command uses the LAST selected shape as the reference.
'
' Generated by ppam/build.py from ppam/Nasaq.template.bas - edit the template, not
' the generated file. User-facing text lives in TextEn/TextAr, generated from
' manifest.xml so both editions share the same labels.
Option Explicit

#If Not Mac Then
Private Declare PtrSafe Function MessageBoxW Lib "user32" (ByVal hWnd As LongPtr, _
    ByVal lpText As LongPtr, ByVal lpCaption As LongPtr, ByVal uType As Long) As Long
Private Const MB_ICONINFORMATION As Long = &H40
Private Const MB_TASKMODAL As Long = &H2000
Private Const MB_RIGHT As Long = &H80000
Private Const MB_RTLREADING As Long = &H100000
#End If

Private Const MSO_LANGUAGE_ID_UI As Long = 2

' ---------------------------------------------------------------------------
' Ribbon callbacks
' ---------------------------------------------------------------------------

Public Sub Nasaq_GetLabel(control As IRibbonControl, ByRef returnedVal)
    returnedVal = Text(control.ID & ".Label")
End Sub

Public Sub Nasaq_GetSupertip(control As IRibbonControl, ByRef returnedVal)
    returnedVal = Text(control.ID & ".Tooltip")
End Sub

Public Sub Nasaq_OnAction(control As IRibbonControl)
    On Error GoTo Failed
    Select Case control.ID
        Case "MatchSize": MatchShapes True, True, "MatchSize"
        Case "MatchWidth": MatchShapes True, False, "MatchWidth"
        Case "MatchHeight": MatchShapes False, True, "MatchHeight"
        Case "Swap": SwapShapes
        Case "AlignLeft": AlignShapes "left"
        Case "AlignCenter": AlignShapes "center"
        Case "AlignRight": AlignShapes "right"
        Case "AlignTop": AlignShapes "top"
        Case "AlignMiddle": AlignShapes "middle"
        Case "AlignBottom": AlignShapes "bottom"
        Case "DuplicateGrid": DuplicateInGrid
    End Select
    Exit Sub
Failed:
    ShowMessage Replace(Text("Message.Unexpected"), "{0}", Err.Description)
End Sub

' ---------------------------------------------------------------------------
' Commands
' ---------------------------------------------------------------------------

' Resizes all selected shapes to the width and/or height of the last selected one.
Private Sub MatchShapes(ByVal matchWidth As Boolean, ByVal matchHeight As Boolean, ByVal commandKey As String)
    Dim shapes As ShapeRange
    If Not RequireTwo(shapes, commandKey) Then Exit Sub

    Dim target As Shape, i As Long, locked As MsoTriState
    Set target = shapes(shapes.Count)
    For i = 1 To shapes.Count - 1
        With shapes(i)
            ' Unlock the aspect ratio so width and height can change independently.
            locked = .LockAspectRatio
            .LockAspectRatio = msoFalse
            If matchWidth Then .Width = target.Width
            If matchHeight Then .Height = target.Height
            .LockAspectRatio = locked
        End With
    Next i
End Sub

' Swaps exactly two shapes, center to center.
Private Sub SwapShapes()
    Dim shapes As ShapeRange
    Set shapes = SelectedShapes()
    If CountOf(shapes) <> 2 Then
        ShowMessage Replace(Text("Message.SwapNeedsTwo"), "{0}", CStr(CountOf(shapes)))
        Exit Sub
    End If

    Dim a As Shape, b As Shape
    Dim ax As Single, ay As Single, bx As Single, by As Single
    Set a = shapes(1)
    Set b = shapes(2)
    ax = a.Left + a.Width / 2: ay = a.Top + a.Height / 2
    bx = b.Left + b.Width / 2: by = b.Top + b.Height / 2
    a.Left = bx - a.Width / 2: a.Top = by - a.Height / 2
    b.Left = ax - b.Width / 2: b.Top = ay - b.Height / 2
End Sub

' Lines up the selected shapes with an edge or center of the last selected shape.
Private Sub AlignShapes(ByVal edge As String)
    Dim shapes As ShapeRange
    If Not RequireTwo(shapes, "Align") Then Exit Sub

    Dim target As Shape, i As Long
    Set target = shapes(shapes.Count)
    For i = 1 To shapes.Count - 1
        With shapes(i)
            Select Case edge
                Case "left": .Left = target.Left
                Case "right": .Left = target.Left + target.Width - .Width
                Case "center": .Left = target.Left + (target.Width - .Width) / 2
                Case "top": .Top = target.Top
                Case "bottom": .Top = target.Top + target.Height - .Height
                Case "middle": .Top = target.Top + (target.Height - .Height) / 2
            End Select
        End With
    Next i
End Sub

' Copies the selection (as one unit) and lays the copies out in a grid. The original
' is the first cell; copies fill left to right, then top to bottom. Columns are
' chosen to make the grid as square as possible (e.g. 8 copies + original = 3 x 3).
Private Sub DuplicateInGrid()
    Const GAP As Single = 10        ' points between cells
    Const MAX_COPIES As Long = 100

    Dim shapes As ShapeRange
    Set shapes = SelectedShapes()
    If CountOf(shapes) = 0 Then
        ShowMessage Text("Message.SelectShapes")
        Exit Sub
    End If

    Dim answer As String
    answer = NormalizeDigits(Trim$(InputBox(Text("Duplicate.Prompt"), Text("App.Name"), "3")))
    If Len(answer) = 0 Then Exit Sub    ' cancelled
    If Not IsWholeNumber(answer) Then
        ShowMessage Text("Message.InvalidCount")
        Exit Sub
    End If
    Dim copies As Long
    copies = CLng(answer)
    If copies < 1 Or copies > MAX_COPIES Then
        ShowMessage Text("Message.InvalidCount")
        Exit Sub
    End If

    ' Bounding box of the selection = size of one grid cell.
    Dim minLeft As Single, minTop As Single, maxRight As Single, maxBottom As Single, i As Long
    minLeft = shapes(1).Left: minTop = shapes(1).Top
    maxRight = shapes(1).Left + shapes(1).Width: maxBottom = shapes(1).Top + shapes(1).Height
    For i = 2 To shapes.Count
        With shapes(i)
            If .Left < minLeft Then minLeft = .Left
            If .Top < minTop Then minTop = .Top
            If .Left + .Width > maxRight Then maxRight = .Left + .Width
            If .Top + .Height > maxBottom Then maxBottom = .Top + .Height
        End With
    Next i
    Dim cellWidth As Single, cellHeight As Single
    cellWidth = maxRight - minLeft + GAP
    cellHeight = maxBottom - minTop + GAP

    Dim columns As Long
    columns = Int(Sqr(copies + 1))
    If columns * columns < copies + 1 Then columns = columns + 1

    Dim n As Long, k As Long, copyRange As ShapeRange
    For n = 1 To copies
        Set copyRange = shapes.Duplicate
        For k = 1 To copyRange.Count
            copyRange(k).Left = shapes(k).Left + (n Mod columns) * cellWidth
            copyRange(k).Top = shapes(k).Top + (n \ columns) * cellHeight
        Next k
    Next n
End Sub

' ---------------------------------------------------------------------------
' Helpers
' ---------------------------------------------------------------------------

' The selected shapes in selection order, or Nothing when no shapes are selected.
Private Function SelectedShapes() As ShapeRange
    On Error GoTo NoShapes
    With ActiveWindow.Selection
        If .Type = ppSelectionShapes Or .Type = ppSelectionText Then Set SelectedShapes = .ShapeRange
    End With
NoShapes:
End Function

Private Function CountOf(ByVal shapes As ShapeRange) As Long
    If Not shapes Is Nothing Then CountOf = shapes.Count
End Function

Private Function RequireTwo(ByRef shapes As ShapeRange, ByVal commandKey As String) As Boolean
    Set shapes = SelectedShapes()
    If CountOf(shapes) >= 2 Then
        RequireTwo = True
    Else
        ShowMessage Replace(Replace(Text("Message.NeedsTwo"), "{0}", Text(commandKey & ".Name")), _
            "{1}", CStr(CountOf(shapes)))
    End If
End Function

Private Function IsWholeNumber(ByVal value As String) As Boolean
    Dim i As Long
    If Len(value) = 0 Or Len(value) > 4 Then Exit Function
    For i = 1 To Len(value)
        If Mid$(value, i, 1) Like "[!0-9]" Then Exit Function
    Next i
    IsWholeNumber = True
End Function

' Converts Arabic-Indic digits (U+0660-U+0669) to 0-9.
Private Function NormalizeDigits(ByVal value As String) As String
    Dim i As Long, code As Long
    For i = 1 To Len(value)
        code = AscW(Mid$(value, i, 1))
        If code >= &H660 And code <= &H669 Then
            NormalizeDigits = NormalizeDigits & ChrW(code - &H660 + 48)
        Else
            NormalizeDigits = NormalizeDigits & Mid$(value, i, 1)
        End If
    Next i
End Function

Private Function IsArabic() As Boolean
    On Error Resume Next
    ' Late-bound: PowerPoint for Mac has no LanguageSettings, so an early-bound call
    ' would not compile there. On Mac this falls back to English.
    Dim app As Object
    Set app = Application
    ' Primary language ID 1 = Arabic (any region).
    IsArabic = (app.LanguageSettings.LanguageID(MSO_LANGUAGE_ID_UI) And &H3FF) = 1
End Function

Private Function Text(ByVal key As String) As String
    If IsArabic() Then Text = TextAr(key)
    If Len(Text) = 0 Then Text = TextEn(key)
End Function

Private Sub ShowMessage(ByVal message As String)
#If Mac Then
    MsgBox message, vbInformation, Text("App.Name")
#Else
    ' MessageBoxW shows Arabic correctly regardless of the system code page.
    Dim flags As Long
    flags = MB_ICONINFORMATION Or MB_TASKMODAL
    If IsArabic() Then flags = flags Or MB_RIGHT Or MB_RTLREADING
    MessageBoxW 0, StrPtr(message), StrPtr(Text("App.Name")), flags
#End If
End Sub

' Builds a string from space-separated hex code points (keeps this file ASCII-only).
Private Function U(ByVal codePoints As String) As String
    Dim parts() As String, i As Long
    parts = Split(codePoints, " ")
    For i = LBound(parts) To UBound(parts)
        U = U & ChrW(CLng("&H" & parts(i)))
    Next i
End Function

